# Liberarr — the ONLY place secrets live. Copy with ./scripts/init-env.sh (it generates the change-me values).
# Never commit .env.

# --- generated by scripts/init-env.sh ---
LIBERARR_SECRET_KEY=change-me
LIBERARR_API_KEY=change-me
LIBERARR_ADMIN_PASSWORD=change-me
LITELLM_MASTER_KEY=change-me

# --- AI provider keys: fill the ones used in litellm.yaml ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- settings (defaults shown) ---
LIBERARR_ADMIN_USERNAME=admin
LIBERARR_AI_BASE_URL=http://litellm:4000
LIBERARR_TRANSCRIBE_MODEL=transcribe
LIBERARR_LLM_MODEL=summarize
# Set to true when served over HTTPS (reverse proxy / Tailscale)
LIBERARR_COOKIE_SECURE=false
LIBERARR_INBOX_POLL_SECONDS=30
# Optional: write Obsidian notes elsewhere than /data/obsidian (path inside the container)
# LIBERARR_OBSIDIAN_DIR=/data/obsidian
